#!name=AI Usage Panel Script
#!desc=Installs the generic Script used by the AI Usage Panel. Add the [Panel] entry described in README.md.
#!arguments=endpoint=https%3A%2F%2Fexample.invalid%2Fai-usage.json

[Script]
ai-usage = type=generic,script-path=https://raw.githubusercontent.com/waychane/Surge-Files/main/Panels/AI-Usage/ai-usage-panel.js,script-update-interval=86400,argument=endpoint=%endpoint%
